{
  "name": "clickor-media-backend",
  "version": "1.0.0",
  "private": true,
  "main": "server.js",
  "bin": "server.js",
  "pkg": {
    "scripts": [
      "server.js",
      "src/**/*.js"
    ],
    "assets": [
      "data/**",
      ".env",
      "src/**/*"
    ],
    "targets": [
      "node18-win-x64"
    ]
  },
  "dependencies": {
    "@prisma/client": "^7.8.0",
    "@supabase/supabase-js": "^2.45.4",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.13.0",
    "sequelize": "^6.37.3",
    "sqlite3": "^5.1.7",
    "xlsx": "^0.18.5"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node src/seed.js",
    "build:exe": "npx pkg . --targets node18-win-x64 --output dist/clickormedia-backend.exe",
    "migrate:to-supabase": "node scripts/migrate-to-supabase.js"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "pkg": "^5.8.1",
    "prisma": "^7.8.0"
  }
}
