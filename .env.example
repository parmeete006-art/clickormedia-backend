# Server
PORT=4000
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Database — SQLite by default (zero setup, a single file on disk).
# To move to real MySQL/Postgres later, see README "Switching to MySQL/Postgres".
DB_DIALECT=sqlite
DB_STORAGE=./data/clickormedia.sqlite

# Shared secret the biometric agent must send with every punch it forwards.
BIOMETRIC_WEBHOOK_SECRET=change-this-too
