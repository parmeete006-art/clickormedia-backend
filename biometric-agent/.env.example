# The office biometric terminal's IP on the local network (check its menu, or your router's device list)
DEVICE_IP=192.168.1.201
DEVICE_PORT=4370

# Your backend's API, reachable from this machine
API_BASE_URL=http://localhost:4000/api
BIOMETRIC_WEBHOOK_SECRET=change-this-too

# How often to poll the device, in milliseconds (default: every 2 minutes)
POLL_INTERVAL_MS=120000

# Optional: If your Attendance Tracker system exposes a report URL,
# the fetch script can download it automatically and drop it into the
# import watcher folder.
TRACKER_EXPORT_URL=https://tracker.example.com/reports/attendance.xlsx
TRACKER_EXPORT_AUTH_TYPE=basic   # none | bearer | header | basic
TRACKER_EXPORT_API_KEY=
TRACKER_EXPORT_API_KEY_HEADER=Authorization
TRACKER_EXPORT_USERNAME=
TRACKER_EXPORT_PASSWORD=
TRACKER_FETCH_INTERVAL_MS=3600000

# Optional: If Attendance Tracker can save exported reports to a local folder,
# the sync script will watch that folder and copy new Excel files into the
# attendance-imports folder so the import watcher can process them.
# Use an absolute path if your tracker writes somewhere else.
TRACKER_EXPORT_FOLDER=./attendance-imports
TRACKER_EXPORT_POLL_INTERVAL_MS=10000

# Daily report import settings
REPORT_IMPORT_ENABLED=true
REPORT_IMPORT_INTERVAL_MS=86400000
